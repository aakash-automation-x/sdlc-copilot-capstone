# Backend
PORT=3000
NODE_ENV=development

# Database (TASK-004)
DATABASE_URL=postgres://user:password@localhost:5432/ecommerce_login

# Redis (TASK-005)
REDIS_URL=redis://localhost:6379

# Auth secrets are loaded via the secrets manager (TASK-003) — never hard-code.
# JWT_ACTIVE_KID names the key currently used for signing.
JWT_ACTIVE_KID=
# JWT_SIGNING_KEYS is a JSON array of {"kid","secret"} injected by the secrets
# manager at runtime — never commit real key material.
JWT_SIGNING_KEYS=
