# Backend
PORT=3000
NODE_ENV=development

# Database (TASK-004)
DATABASE_URL=postgres://user:password@localhost:5432/ecommerce_login

# Redis (TASK-005)
REDIS_URL=redis://localhost:6379

# Auth secrets are loaded via the secrets manager (TASK-003) — never hard-code.
# This only names the active signing key id; the key material lives in the vault.
JWT_SIGNING_KEY_ID=
