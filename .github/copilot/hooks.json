{
  "$schema": "https://json.schemastore.org/copilot-hooks.json",
  "version": 1,
  "description": "Lifecycle hooks that enforce the Agentic SDLC pipeline gates.",
  "hooks": {
    "SessionStart": [
      {
        "name": "announce-pipeline",
        "run": "node .github/copilot/hooks/validate-artifacts.js --mode session"
      }
    ],
    "PreToolUse": [
      {
        "name": "block-secret-commits",
        "matcher": "shell|run_in_terminal|git",
        "run": "node .github/copilot/hooks/check-secrets.js"
      }
    ],
    "Stop": [
      {
        "name": "secret-scan-on-finish",
        "run": "node .github/copilot/hooks/check-secrets.js --staged"
      }
    ]
  }
}
